# Server Pulse Micro-Agent Environment Template
# Copy to .env on the server and replace PULSE_TOKEN with a strong secret:
# openssl rand -hex 32

PULSE_BIND=0.0.0.0
PULSE_PORT=9191
PULSE_TOKEN=replace_with_64_char_random_hex_token
PULSE_CACHE_TTL_MS=2500
PULSE_TOP_PROCESSES=6
DOCKER_SOCKET=/var/run/docker.sock
